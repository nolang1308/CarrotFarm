# macOS 서명·공증 자격증명 — 실제 값은 .env.release 에 복사해서 채우세요 (git에 커밋되지 않음)
# 릴리스 스크립트(scripts/release.sh)가 자동으로 읽습니다.

# Apple ID (개발자 계정 이메일)
APPLE_ID=

# 앱 암호 (Apple ID 비밀번호 아님! https://account.apple.com → 로그인 및 보안 → 앱 암호에서 생성)
APPLE_APP_SPECIFIC_PASSWORD=

# 팀 ID (https://developer.apple.com/account → Membership details 의 Team ID, 10자리)
APPLE_TEAM_ID=
